# ==================== 镜像版本 ====================
APP_VERSION=latest

# ==================== 对外访问 ====================
# 必须填写 Nginx 暴露给浏览器访问的完整地址，例如：http://studio.example.com
WAOO_PUBLIC_URL=http://studio.example.com

# 当前系统应用端口仅监听 127.0.0.1，给 Nginx 反向代理使用
WAOO_APP_PORT=13000
WAOO_BULL_BOARD_PORT=13010

# ==================== 复用 AI 培训平台 MySQL ====================
# AI 培训平台 mysql 使用 network_mode: host，因此这里连宿主机 3306
WAOO_DB_PORT=3306
WAOO_DB_NAME=waoowaoo
WAOO_DB_USERNAME=waoowaoo
WAOO_DB_PASSWORD=please-change-waoowaoo-db-password

# ==================== 复用 AI 培训平台 Redis ====================
WAOO_REDIS_PORT=6379
WAOO_REDIS_USERNAME=
WAOO_REDIS_PASSWORD=
WAOO_REDIS_TLS=

# ==================== 当前系统独立 MinIO ====================
WAOO_MINIO_API_PORT=19000
WAOO_MINIO_CONSOLE_PORT=19001
# 默认使用容器内地址，启动最简单。
# 如果浏览器访问 /api/storage/sign 后需要直连 MinIO 签名 URL，建议改成可公网访问的文件域名，例如：http://files.example.com
WAOO_MINIO_ENDPOINT=http://minio:9000
WAOO_MINIO_ROOT_USER=waoowaoo_minio
WAOO_MINIO_ROOT_PASSWORD=please-change-minio-password
WAOO_MINIO_BUCKET=waoowaoo
WAOO_MINIO_REGION=us-east-1

# ==================== 认证与内部密钥 ====================
# 建议用 openssl rand -base64 32 生成
WAOO_NEXTAUTH_SECRET=please-change-nextauth-secret
WAOO_CRON_SECRET=please-change-cron-secret
WAOO_INTERNAL_TASK_TOKEN=please-change-internal-task-token
WAOO_API_ENCRYPTION_KEY=please-change-api-encryption-key

# 私有部署默认关闭注册
AUTH_REGISTRATION_ENABLED=false
AUTH_ALLOW_NON_ADMIN_LOGIN=false
SYSTEM_CONFIG_OWNER_USER_ID=

# ==================== AI 培训平台 SSO（按需启用） ====================
# 示例 1：走公网域名
# AI_TRAINING_SSO_VERIFY_URL=https://ai.example.com/api/sso/ticket/verify
#
# 示例 2：走同机 Nginx 转发路径，但签名按真实后端 path 计算
# AI_TRAINING_SSO_VERIFY_URL=http://host.docker.internal/prod-api/api/sso/ticket/verify
# AI_TRAINING_SSO_SIGNATURE_PATH=/api/sso/ticket/verify
AI_TRAINING_SSO_VERIFY_URL=
AI_TRAINING_SSO_SIGNATURE_PATH=
AI_TRAINING_SSO_CLIENT_ID=ai-video-workshop
AI_TRAINING_SSO_CLIENT_SECRET=
AI_TRAINING_SSO_TIMEOUT_MS=5000

# ==================== Bull Board ====================
WAOO_BULL_BOARD_USER=admin
WAOO_BULL_BOARD_PASSWORD=please-change-bull-board-password

# ==================== Worker 并发 ====================
WATCHDOG_INTERVAL_MS=30000
TASK_HEARTBEAT_TIMEOUT_MS=90000
QUEUE_CONCURRENCY_IMAGE=50
QUEUE_CONCURRENCY_VIDEO=50
QUEUE_CONCURRENCY_VOICE=20
QUEUE_CONCURRENCY_TEXT=50

# ==================== 其他 ====================
LOG_LEVEL=INFO
BILLING_MODE=OFF
LLM_STREAM_EPHEMERAL_ENABLED=true
